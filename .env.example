NEXT_PUBLIC_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ADMIN WALLET PRIVATE KEY & PUBLIC ADDRESS
PRIVATE_KEY=YOUR_ADMIN_WALLET_PRIVATE_KEY
NEXT_PUBLIC_ADMIN_WALLET=0xYourAdminWalletAddress

# NETWORK CONFIGURATION (1 = Mainnet, 11155111 = Sepolia)
NEXT_PUBLIC_CHAIN_ID=1

# REAL ETHEREUM MAINNET USDT CONTRACT
